      { "name": "twin-peaked", "widthScale": 1.15, "heightScale": 1.1,
        "lobeCenters": [[0.1, 0.7, 0.14], [0.27, 0.45, 0.25], [0.5, 0.7, 0.22], [0.73, 0.4, 0.25], [0.9, 0.7, 0.12]] }
