        "lobeCenters": [[0.12, 0.7, 0.14], [0.3, 0.6, 0.18], [0.5, 0.55, 0.22], [0.72, 0.62, 0.18], [0.9, 0.73, 0.1]] },
      { "name": "towering", "widthScale": 0.8, "heightScale": 1.5,
