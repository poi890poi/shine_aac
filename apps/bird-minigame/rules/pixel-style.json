{
  "schemaVersion": 1,
  "ruleVersion": "1.0.0",
  "intent": "One deliberately drawn pixel language across every garden object. Geometry is rasterized onto one square grid, never filtered from mixed-resolution art.",
  "grid": { "minimumWidth": 240, "columnPitch": 36, "minimumHeight": 260, "maximumHeight": 420 },
  "outline": { "width": 1, "foreground": "ink", "background": "cloudShadow" },
  "shading": { "bands": 3, "lightDirection": [-1, -1], "highlightThreshold": -0.25, "shadowThreshold": 0.4 },
  "clusters": { "minimumArea": 3, "textureDensity": 0.16, "singlePixelExceptions": ["eyes", "bill tip", "grass blade tips", "liquid splash tips"] },
  "animation": { "framesPerSecond": 8, "cloudPixelsPerSecond": 3, "snapPositions": true },
  "bird": { "speciesId": "taiwan_blue_magpie", "torsoPixels": 20, "tailFeathers": 3, "eyePixels": 1, "tailTipFraction": 0.17 },
  "flower": { "headRadius": 13, "faceRadius": 6, "petalCount": 8, "petalRadius": 4, "petalRingRadius": 9, "stemWidth": 3, "leafLength": 8, "leafWidth": 4, "leafLevels": [0.35, 0.67] },
  "cloud": { "width": 42, "height": 18, "lobeCenters": [[0.18, 0.66, 0.18], [0.42, 0.46, 0.27], [0.7, 0.61, 0.22], [0.86, 0.75, 0.13]] },
  "grass": { "tileSize": 16, "bladeHeight": 4, "tuftWidth": 5 },
  "palette": {
    "ink": "#20243a", "white": "#ffffff", "sky": "#91d5db", "cloudShadow": "#65a8c0",
    "blueShadow": "#344b88", "blue": "#4876bd", "blueLight": "#83b5dd",
    "greenShadow": "#386541", "green": "#69a64b", "greenLight": "#a5cc62",
    "petalShadow": "#aa4863", "petal": "#e5788c", "petalLight": "#ffc1a0",
    "goldShadow": "#be793d", "gold": "#f2ca67", "cloudLight": "#d8ead8"
  },
  "ramps": {
    "bird": ["blueShadow", "blue", "blueLight"], "plant": ["greenShadow", "green", "greenLight"],
    "petal": ["petalShadow", "petal", "petalLight"], "face": ["goldShadow", "gold", "petalLight"],
    "cloud": ["cloudShadow", "cloudLight", "white"]
  },
  "acceptance": {
    "squarePixels": true, "nativeSpritesOnly": true, "perObjectResampling": false,
    "smoothRotation": false, "palettePostFilter": false, "randomDithering": false,
    "reviewAtNativeScaleAndIntegerZoom": true,
    "preserveSpeciesRatios": true, "preserveTailArcLength": true
  }
}
