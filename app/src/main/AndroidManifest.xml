<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${shineAppLabel}"
        android:manageSpaceActivity=".ResourceManagementActivity"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SHINEAAC"
        tools:targetApi="31">
        <activity
            android:name=".ResourceManagementActivity"
            android:exported="true"
            android:label="@string/resources_title"
            android:theme="@style/Theme.SHINEAAC.Resources" />
        <activity
            android:name=".InputTestActivity"
            android:exported="false"
            android:label="@string/settings_input_test"
            android:theme="@style/Theme.SHINEAAC.Settings" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.SHINEAAC.Settings" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:label="${shineAppLabel}"
            android:theme="@style/Theme.SHINEAAC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
